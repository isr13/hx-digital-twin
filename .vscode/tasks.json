{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install Python Dependencies",
            "type": "shell",
            "command": "pip install -r requirements.txt",
            "cwd": "${workspaceFolder}/backend",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Install Frontend Dependencies",
            "type": "shell",
            "command": "npm install",
            "cwd": "${workspaceFolder}/frontend",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Python Backend",
            "type": "shell",
            "command": "uvicorn engine:app --host 127.0.0.1 --port 8000",
            "cwd": "${workspaceFolder}/backend",
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Run Tauri Frontend",
            "type": "shell",
            "command": "npm run tauri dev",
            "cwd": "${workspaceFolder}/frontend",
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "isBackground": true,
            "problemMatcher": []
        }
    ]
}